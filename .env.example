# Puerto del Servidor Backend
PORT=3000
NODE_ENV=development

# Base de datos (SQLite por defecto para desarrollo local sin dependencias)
# Para PostgreSQL en producción: postgresql://user:password@localhost:5432/pumaker?schema=public
DATABASE_URL="file:./dev.db"

# Seguridad y Autenticación JWT para Administradores
JWT_SECRET="pumaker_super_secret_jwt_key_change_in_production_unam_2026"
JWT_EXPIRES_IN="7d"

# Administrador Inicial del Sistema (utilizado en el seed inicial)
ADMIN_DEFAULT_USER="admin@pumaker.unam.mx"
ADMIN_DEFAULT_PASSWORD="Pumaker2026!AdminSecure"

# URLs permitidas para CORS
CORS_ORIGIN="http://localhost:5173"
